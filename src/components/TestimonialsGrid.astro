---
interface Props {
  testimonials: {
    id: string;
    data: {
      name: string;
      role: string;
      company: string;
      companyUrl?: string;
      avatar?: string;
      quote: string;
    };
  }[];
}

const { testimonials } = Astro.props;
---

<div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
  {testimonials.map((testimonial, index) => (
    <div 
      class="glass-card p-6 hover-lift group"
      style={`animation-delay: ${index * 100}ms`}
    >
      <!-- Quote Icon -->
      <div class="text-4xl text-primary-300 dark:text-primary-700 mb-4">"</div>
      
      <!-- Quote Text -->
      <blockquote class="text-slate-600 dark:text-slate-400 mb-6 italic">
        {testimonial.data.quote}
      </blockquote>
      
      <!-- Author -->
      <div class="flex items-center gap-4">
        <!-- Avatar -->
        <div class="w-12 h-12 rounded-full overflow-hidden bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center flex-shrink-0">
          {testimonial.data.avatar ? (
            <img 
              src={testimonial.data.avatar} 
              alt={testimonial.data.name}
              class="w-full h-full object-cover"
            />
          ) : (
            <span class="text-white font-bold text-lg">
              {testimonial.data.name.charAt(0)}
            </span>
          )}
        </div>
        
        <!-- Info -->
        <div>
          <div class="font-semibold text-slate-900 dark:text-slate-100">
            {testimonial.data.name}
          </div>
          <div class="text-sm text-slate-500 dark:text-slate-400">
            {testimonial.data.role}
            {testimonial.data.companyUrl ? (
              <a 
                href={testimonial.data.companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-primary-600 dark:text-primary-400 hover:underline"
              >
                @ {testimonial.data.company}
              </a>
            ) : (
              <span>@ {testimonial.data.company}</span>
            )}
          </div>
        </div>
      </div>
    </div>
  ))}
</div>
