---
const currentYear = new Date().getFullYear();

// Configuration - Update these values or use environment variables
const config = {
    email: import.meta.env.PUBLIC_CONTACT_EMAIL || "dragusanuc@gmail.com",
    github: import.meta.env.PUBLIC_GITHUB_USERNAME || "catalindragusanu",
    linkedin: import.meta.env.PUBLIC_LINKEDIN_USERNAME || "dragusanu-catalin-523b00178",
    twitter: import.meta.env.PUBLIC_TWITTER_USERNAME || "yourusername",
};

const socialLinks = [
    {
        name: "GitHub",
        href: `https://github.com/${config.github}`,
        icon: "M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z",
    },
    {
        name: "LinkedIn",
        href: `https://linkedin.com/in/${config.linkedin}`,
        icon: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
    },
    {
        name: "Twitter",
        href: `https://twitter.com/${config.twitter}`,
        icon: "M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z",
    },
];

const footerLinks = [
    { name: "Home", href: "/" },
    { name: "Projects", href: "/projects" },
    { name: "Blog", href: "/blog" },
    { name: "About", href: "/about" },
    { name: "RSS", href: "/rss.xml" },
];
---

<footer class="mt-auto">
    <div class="max-w-6xl mx-auto px-6 py-16">
        <!-- Top Section -->
        <div class="glass-card p-8 md:p-12 mb-8">
            <div class="grid md:grid-cols-2 gap-8 items-center">
                <div>
                    <h2 class="text-2xl md:text-3xl font-bold mb-4">
                        Let's work <span class="text-gradient">together</span>
                    </h2>
                    <p class="text-slate-600 dark:text-slate-400 mb-6">
                        Got a project in mind? I'd love to hear about it. Drop
                        me a message and let's create something amazing.
                    </p>
                    <a href={`mailto:${config.email}`} class="btn-primary">
                        <svg
                            class="w-5 h-5 mr-2"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                            ></path>
                        </svg>
                        Get in Touch
                    </a>
                </div>
                <div class="flex justify-center md:justify-end">
                    <div class="relative">
                        <div
                            class="w-32 h-32 rounded-2xl bg-gradient-to-br from-primary-500 to-accent-500 opacity-20 blur-2xl absolute -inset-4"
                        >
                        </div>
                        <div
                            class="relative w-32 h-32 rounded-2xl bg-gradient-to-br from-primary-500 to-accent-500 flex items-center justify-center"
                        >
                            <span class="text-5xl">👋</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bottom Section -->
        <div
            class="flex flex-col md:flex-row items-center justify-between gap-6 pt-8 border-t border-slate-200 dark:border-slate-800"
        >
            <!-- Copyright -->
            <p class="text-slate-600 dark:text-slate-400 text-sm">
                © {currentYear} Portfolio. Built with
                <a
                    href="https://astro.build"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary-600 dark:text-primary-400 hover:underline"
                    >Astro</a
                >.
            </p>

            <!-- Footer Links -->
            <nav class="flex flex-wrap items-center justify-center gap-6">
                {
                    footerLinks.map((link) => (
                        <a
                            href={link.href}
                            class="text-sm text-slate-600 dark:text-slate-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                        >
                            {link.name}
                        </a>
                    ))
                }
            </nav>

            <!-- Social Links -->
            <div class="flex items-center gap-4">
                {
                    socialLinks.map((social) => (
                        <a
                            href={social.href}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="w-10 h-10 rounded-xl bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-400 hover:bg-primary-100 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                            aria-label={social.name}
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path d={social.icon} />
                            </svg>
                        </a>
                    ))
                }
            </div>
        </div>
    </div>
</footer>
