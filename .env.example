# Portfolio Builder - Environment Variables
# Copy this file to .env and update the values

# ===========================================
# REQUIRED: Site Configuration
# ===========================================

# Your site URL (used for sitemaps, canonical URLs, etc.)
SITE_URL=https://myportfolio.com

# ===========================================
# REQUIRED: Personal Information
# ===========================================

# Your name (displayed on home page hero)
PUBLIC_AUTHOR_NAME=Your Name

# Your role/title
PUBLIC_AUTHOR_ROLE=Full-Stack Developer

# Hero section tagline
PUBLIC_TAGLINE=I build exceptional digital experiences with modern technologies.

# Years of experience (displayed on home page)
PUBLIC_YEARS_EXPERIENCE=5+

# ===========================================
# REQUIRED: Contact & Social
# ===========================================

# Your contact email (shown on site and used for FormSubmit)
PUBLIC_CONTACT_EMAIL=hello@yourdomain.com

# FormSubmit email (if different from contact email)
# PUBLIC_FORMSUBMIT_EMAIL=contact@yourdomain.com

# Social media usernames
PUBLIC_GITHUB_USERNAME=yourusername
PUBLIC_LINKEDIN_USERNAME=yourusername
PUBLIC_TWITTER_USERNAME=yourusername

# ===========================================
# OPTIONAL: Resume
# ===========================================

# URL to your resume PDF (default: /resume.pdf)
# PUBLIC_RESUME_URL=/resume.pdf

# Set to "false" to hide the resume download button
# PUBLIC_SHOW_RESUME=true

# ===========================================
# OPTIONAL: Analytics
# ===========================================

# Google Analytics 4 Measurement ID
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics domain
# PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# Umami Analytics
# PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PUBLIC_UMAMI_URL=https://analytics.yourdomain.com

# ===========================================
# DEPLOYMENT: Netlify (set in CI/CD secrets)
# ===========================================

# These should be set as GitHub repository secrets, not in .env
# NETLIFY_SITE_ID=your-site-id
# NETLIFY_AUTH_TOKEN=your-auth-token

# ===========================================
# OPTIONAL: Notifications
# ===========================================

# Slack webhook for deployment notifications
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx
